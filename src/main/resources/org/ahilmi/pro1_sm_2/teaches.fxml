<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="800.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ahilmi.pro1_sm_2.Controller.TeachController">

    <children>
        <Label layoutX="28.0" layoutY="36.0" text="Professor ID:" />
        <Label layoutX="26.0" layoutY="81.0" text="Course ID:" />
        <Label layoutX="26.0" layoutY="127.0" text="Starting Date:" />
        <Label layoutX="25.0" layoutY="168.0" text="Ending Date:" />
        <Label layoutX="22.0" layoutY="204.0" text="Student Count:" />

        <TextField fx:id="courseId" layoutX="108.0" layoutY="77.0" />
        <TextField fx:id="professorId" layoutX="108.0" layoutY="32.0" />
        <TextField fx:id="studentCount" layoutX="108.0" layoutY="200.0" />
        <TextField fx:id="endingDate" layoutX="108.0" layoutY="164.0" promptText="YYYY-MM-DD"/>
        <TextField fx:id="startingDate" layoutX="108.0" layoutY="123.0" promptText="YYYY-MM-DD"/>


        <Button fx:id="getTeach" layoutX="302.0" layoutY="32.0" mnemonicParsing="false" onAction="#getTeach" text="GET" />
        <Button fx:id="clearTeach" layoutX="302.0" layoutY="99.0" mnemonicParsing="false" onAction="#clearTeach" text="CLEAR" />
        <Button fx:id="saveTeach" layoutX="15.0" layoutY="242.0" mnemonicParsing="false" onAction="#saveTeach" text="SAVE" />
        <Button fx:id="closeTeach" layoutX="274.0" layoutY="242.0" mnemonicParsing="false" onAction="#closeTeach" text="CLOSE" />
        <Button fx:id="deleteTeach" layoutX="99.0" layoutY="242.0" mnemonicParsing="false" onAction="#deleteTeach" text="DELETE" />
        <Button fx:id="updateTeach" layoutX="174.0" layoutY="242.0" mnemonicParsing="false" onAction="#updateTeach" text="UPDATE" />


    </children>



</AnchorPane>
